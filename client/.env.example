VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Leave empty in development: API calls stay same-origin and Vite proxies
# /api to VITE_PROXY_TARGET below.
VITE_API_BASE_URL=
# Which backend the dev server forwards /api to (local, or the deployed API).
VITE_PROXY_TARGET=https://raiden-url.duckdns.org
# Public origin short links resolve on. Falls back to VITE_API_BASE_URL.
VITE_SHORTLINK_BASE_URL=https://raiden-url.duckdns.org
VITE_POLL_INTERVAL_MS=30000
