# --- App ---
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed frontend origins (CORS + email/link URLs).
# In production this is your Vercel domain, e.g. https://short-link.vercel.app
# (add staging too if you have one: https://a.vercel.app,https://b.vercel.app)
CLIENT_URL=http://localhost:5173

# Public URL of this API — used to build password-reset links.
# In production this is your VPS domain, e.g. https://api.your-domain.com
SERVER_URL=http://localhost:3000

# --- Database & Cache ---
DATABASE_URL=postgresql://user:password@localhost:5432/shortlink
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# --- Auth ---
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
VERIFICATION_TOKEN_SECRET=change-me
RESET_PASSWORD_TOKEN_SECRET=change-me

# Google OAuth (if enabled)
CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Misc ---
NANOID_SIZE=7
VISITOR_HASH_SALT=change-me

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.com
