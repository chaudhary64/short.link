<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to short.link</title>
</head>

<body
    style="margin:0;padding:0;background:#f5f3ee;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;font-family:Arial,Helvetica,sans-serif;">

    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#f5f3ee;">
        Welcome to short.link! We're excited to have you on board.
    </div>
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
        &#847; &zwnj; &nbsp; &#8199; &shy; &#8199; &nbsp; &#8199; &zwnj; &nbsp; &#847;
    </div>

    <center style="width:100%;background:#f5f3ee;">
        <!--[if mso]>
<table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td>
<![endif]-->
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="#f5f3ee"
            style="background-color:#f5f3ee;">
            <tr>
                <td align="center" style="padding:24px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" bgcolor="#ffffff"
                        style="width:600px;background:#ffffff;border:2px solid #141414;">
                        <tr>
                            <td style="padding:40px;">

                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td align="center" style="padding-bottom:24px;">
                                            <img src="<%= logoUrl %>"
                                                alt="short.link" width="60" height="60" border="0"
                                                style="display:block;border:0;outline:none;text-decoration:none;width:60px;height:60px;">
                                        </td>
                                    </tr>
                                </table>

                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:16px;">
                                            Hi <span style="font-weight:bold;">
                                                <%= name %>
                                            </span>,
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:16px;">
                                            Welcome to <span style="font-weight:bold;">short.link</span>! We're thrilled to have you join us.
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:24px;">
                                            With short.link, you can easily shorten URLs and track detailed analytics for all your links in one sleek platform.
                                        </td>
                                    </tr>

                                    <tr>
                                        <td align="center" style="padding-bottom:28px;">
                                            <!--[if mso]>
<v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="<%= actionUrl %>" style="height:48px;v-text-anchor:middle;width:220px;" arcsize="0" stroke="f" fillcolor="#1d4ed8">
<w:anchorlock/>
<center style="color:#ffffff;font-family:Arial;font-size:16px;font-weight:bold;">
Go to Dashboard
</center>
</v:roundrect>
<![endif]-->
                                            <!--[if !mso]><!-- -->
                                            <a href="<%= actionUrl %>"
                                                style="background:#1d4ed8;color:#ffffff;text-decoration:none;font-size:16px;font-weight:bold;line-height:48px;display:inline-block;padding:0 28px;">
                                                Go to Dashboard
                                            </a>
                                            <!--<![endif]-->
                                        </td>
                                    </tr>

                                     <tr>
                                         <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:12px;">
                                             If the button above doesn't work, copy and paste this link into your browser:
                                         </td>
                                     </tr>

                                     <tr>
                                         <td style="font-size:14px;line-height:22px;color:#1d4ed8;padding-bottom:24px;word-break:break-all;">
                                             <%= actionUrl %>
                                         </td>
                                     </tr>

                                     <tr>
                                         <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:24px;">
                                             If you ever have questions or feedback, feel free to reply directly to this email. We're always here to help!
                                         </td>
                                     </tr>

                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;">
                                            Thanks,<br>
                                            <span style="font-weight:bold;">The short.link Team</span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding-top:28px;font-size:11px;line-height:16px;color:#6e6859;">
                                            © <%= currentYear %> short.link · ALL RIGHTS RESERVED
                                        </td>
                                    </tr>
                                </table>

                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
    </center>
</body>

</html>
