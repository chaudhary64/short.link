<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Short.link Account</title>
</head>

<body
    style="margin:0;padding:0;background:#f6f9fc;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;font-family:Arial,Helvetica,sans-serif;">

    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#f6f9fc;">
        Please verify your Short.link email address — this link expires in 24 hours.
    </div>
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
        &#847; &zwnj; &nbsp; &#8199; &shy; &#8199; &nbsp; &#8199; &zwnj; &nbsp; &#847;
    </div>

    <center style="width:100%;background:#f6f9fc;">
        <!--[if mso]>
<table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td>
<![endif]-->
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="#f6f9fc"
            style="background-color:#f6f9fc;">
            <tr>
                <td align="center" style="padding:24px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" bgcolor="#ffffff"
                        style="width:600px;background:#ffffff;border:1px solid #e5e7eb;">
                        <tr>
                            <td style="padding:40px;">

                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td align="center" style="padding-bottom:24px;">
                                            <img src="https://short-link-ochre.vercel.app/logo-dark-v2.svg"
                                                alt="Short.link" width="60" height="60" border="0"
                                                style="display:block;border:0;outline:none;text-decoration:none;width:60px;height:60px;">
                                        </td>
                                    </tr>
                                </table>

                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:16px;">
                                            Hi <span style="font-weight:bold;">
                                                <%= name %>
                                            </span>,
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:16px;">
                                            Thanks for signing up for <span style="font-weight:bold;">Short.link</span>! Before you get started, we need to verify your email address.
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:24px;">
                                            Click the button below to verify your account. This verification link expires in <span style="font-weight:bold;">24 hours</span>.
                                        </td>
                                    </tr>

                                    <tr>
                                        <td align="center" style="padding-bottom:28px;">
                                            <!--[if mso]>
<v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="<%= verifyUrl %>" style="height:48px;v-text-anchor:middle;width:220px;" arcsize="8%" stroke="f" fillcolor="#2563eb">
<w:anchorlock/>
<center style="color:#ffffff;font-family:Arial;font-size:16px;font-weight:bold;">
Verify Your Account
</center>
</v:roundrect>
<![endif]-->
                                            <!--[if !mso]><!-- -->
                                            <a href="<%= verifyUrl %>"
                                                style="background:#2563eb;color:#ffffff;text-decoration:none;font-size:16px;font-weight:bold;line-height:48px;display:inline-block;padding:0 28px;">
                                                Verify Your Account
                                            </a>
                                            <!--<![endif]-->
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:12px;">
                                            If the button above doesn't work, copy and paste this link into your
                                            browser:
                                        </td>
                                    </tr>

                                    <tr>
                                        <td
                                            style="font-size:14px;line-height:22px;color:#2563eb;padding-bottom:24px;word-break:break-all;">
                                            <%= verifyUrl %>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;padding-bottom:24px;">
                                            If you didn't create a Short.link account, you can safely ignore this email.
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-size:16px;line-height:26px;color:#404040;">
                                            Thanks,<br>
                                            <span style="font-weight:bold;">The Short.link Team</span>
                                        </td>
                                    </tr>
                                </table>

                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
    </center>
</body>

</html>
